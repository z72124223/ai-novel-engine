                "packId": "chenxing-formal-v4-opening-scenes"
            }
        ],
        "entities": {
            "locations": [
                {
                    "id": "loc-ruin-threshold",
                    "name": "廢墟門檻",
                    "description": "山坡廢棄構造物的主入口門洞。暴風雨夜可擋風，但門內空氣與離海距離不符。",
                    "parentLocationId": "loc-hillside-ruin"
                },
                {
                    "id": "loc-ruin-first-shelter",
                    "name": "首間避風室",
                    "description": "破舊但足夠擋風的內部空間；手機仍無訊號，公開紀錄中幾乎找不到這處遺跡。",
                    "parentLocationId": "loc-hillside-ruin"
                },
                {
                    "id": "loc-ruin-service-corridor",
                    "name": "傾斜服務走廊",
                    "description": "日治火力發電相關設施的傾斜走廊，殘留舊單位標記、生鏽推床螺栓與低處中文刻痕。",
                    "parentLocationId": "loc-hillside-ruin"
                },
                {
                    "id": "loc-ruin-dead-room",
                    "name": "開放區亡者側室",
                    "description": "封存失敗的實驗側室：乾燥遺留、針孔叢集、編號標籤與空拘束帶，非普通戰爭炮彈痕跡。",
                    "parentLocationId": "loc-hillside-ruin"
                },
                {
                    "id": "loc-ruin-specimen-storage",
                    "name": "標本儲存區",
                    "description": "高大灰色玻璃瓶排架區；瓶內為二戰時期浸泡保存的人體標本，液體已呈灰褐色。",
                    "parentLocationId": "loc-hillside-ruin"
                },
                {
                    "id": "loc-ruin-gold-vault",
                    "name": "指揮室黃金暗格",
                    "description": "指揮室側假牆後空隙；留有日方來不及運走的軍用木箱、布捆金條與部分硬幣。",
                    "parentLocationId": "loc-hillside-ruin"
                }
            ],
            "facts": [
                {
                    "id": "fact-ruin-interior-missing-sea-smell",
                    "content": "廢墟門內空氣與離海距離不符——缺少應有的海風鹹味與皮膚黏膩感。"
                },
                {
                    "id": "fact-ruin-interior-experiment-traces",
                    "content": "廢墟內部殘留量測尺、拘束帶、生鏽推床螺栓與編號標籤等戰時實驗設施痕跡，非普通炮彈破壞。"
                },
                {
                    "id": "fact-ruin-grey-glass-bottles",
                    "content": "廢墟深處有高大灰色玻璃瓶，內為二戰時期浸泡保存的人體標本；液體已呈灰褐色。"
                },
                {
                    "id": "fact-ruin-japanese-gold-cache",
                    "content": "指揮室暗格留有日方來不及運走的軍用木箱、布捆金條與部分硬幣；重量極大，難以一次帶走。"
                }
            ],
            "scenes": [
                {
                    "id": "scene-ruin-threshold-entry",
                    "title": "門檻進入",
                    "summary": "愛醬在門前遲疑，陸塵行與愛醬跨入門檻；手電照見鏽栓與剝落字跡，海風味在此失效。",
                    "locationId": "loc-ruin-threshold"
                },
                {
                    "id": "scene-ruin-first-shelter",
                    "title": "首間避風",
                    "summary": "破舊但足夠擋風的內部空間。陸塵行蹲下喘息，愛醬貼近；他意識到這處遺跡在公開紀錄中幾乎不存在。",
                    "locationId": "loc-ruin-first-shelter"
                },
                {
                    "id": "scene-ruin-service-corridor",
                    "title": "往深處",
                    "summary": "手電柱狀光在傾斜走廊前移；舊日製單位標記、生鏽推床螺栓與牆上低處刻痕。好奇心壓過單純避難。",
                    "locationId": "loc-ruin-service-corridor"
                },
                {
                    "id": "scene-ruin-dead-room",
                    "title": "開放區亡者",
                    "summary": "實驗側室殘留：乾燥遺留、針孔叢集、編號標籤。陸塵行理解這裡不是普通廢墟。",
                    "locationId": "loc-ruin-dead-room"
                },
                {
                    "id": "scene-ruin-grey-bottles",
                    "title": "灰色玻璃瓶",
                    "summary": "高大灰玻璃瓶排架。陸塵行湊近一瓶，光線移過，裡面是二戰時期浸泡保存的人體；愛醬猛然後退乾嘔。",
                    "locationId": "loc-ruin-specimen-storage"
                },
                {
                    "id": "scene-ruin-gold-cache",
                    "title": "來不及運走的黃金",
                    "summary": "指揮室側暗格：軍用木箱與布捆金條。陸塵行掂重量後只帶走能攜帶的分量，仍打算之後再回來。",
                    "locationId": "loc-ruin-gold-vault"
                }
            ],
