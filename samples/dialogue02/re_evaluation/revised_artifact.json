    "languageProfileId":  "language-zh-Hant-TW-natural-v1",
    "languageProfileSha256":  "a5b1dd32d1361950fecb6424c26634f3706a2be4d5316c15204abe7bced31e78",
    "lines":  [
                  {
                      "lineId":  "dlg-001",
                      "sceneId":  "scene-01",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "好。今天還有別的。",
                      "shotIds":  [
                                      "shot-003"
                                  ]
                  },
                  {
                      "lineId":  "dlg-002",
                      "sceneId":  "scene-01",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "又不肯直接講。",
                      "shotIds":  [
                                      "shot-003"
                                  ]
                  },
                  {
                      "lineId":  "dlg-003",
                      "sceneId":  "scene-01",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "有人搬過。還不只一趟。",
                      "shotIds":  [
                                      "shot-004"
                                  ]
                  },
                  {
                      "lineId":  "dlg-004",
                      "sceneId":  "scene-01",
                      "speakerId":  "character-zhou-ke",
                      "text":  "十分鐘！走人！",
                      "shotIds":  [
                                      "shot-005"
                                  ]
                  },
                  {
                      "lineId":  "dlg-005",
                      "sceneId":  "scene-01",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "你上次的十分鐘，有含稅嗎？",
                      "shotIds":  [
                                      "shot-006"
                                  ]
                  },
                  {
                      "lineId":  "dlg-006",
                      "sceneId":  "scene-01",
                      "speakerId":  "character-zhou-ke",
                      "text":  "今天不要賭。",
                      "shotIds":  [
                                      "shot-006"
                                  ]
                  },
                  {
                      "lineId":  "dlg-007",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-zhou-ke",
                      "text":  "照片呢？",
                      "shotIds":  [
                                      "shot-009"
                                  ]
                  },
                  {
                      "lineId":  "dlg-008",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "卡住了。看它賞不賞臉。",
                      "shotIds":  [
                                      "shot-009"
                                  ]
                  },
                  {
                      "lineId":  "dlg-009",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-zhou-ke",
                      "text":  "山坡在另一邊。",
                      "shotIds":  [
                                      "shot-011"
                                  ]
                  },
                  {
                      "lineId":  "dlg-010",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "先看得到的。",
                      "shotIds":  [
                                      "shot-011"
                                  ]
                  },
                  {
                      "lineId":  "dlg-011",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-tide-picker",
                      "text":  "別碰箱子。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-013"
                                  ]
                  },
                  {
                      "lineId":  "dlg-012",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "先救你。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-013"
                                  ]
                  },
                  {
                      "lineId":  "dlg-013",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-tide-picker",
                      "text":  "那是我的。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-013"
                                  ]
                  },
                  {
                      "lineId":  "dlg-014",
                      "sceneId":  "scene-02",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "先上去。箱子等等再說。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-013"
                                  ]
                  },
                  {
                      "lineId":  "dlg-015",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "我抬石頭。你拉人。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-017"
                                  ]
                  },
                  {
                      "lineId":  "dlg-016",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-zhou-ke",
                      "text":  "箱子？",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-017"
                                  ]
                  },
                  {
                      "lineId":  "dlg-017",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "不管。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-017"
                                  ]
                  },
                  {
                      "lineId":  "dlg-018",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-tide-picker",
                      "text":  "不行！",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-017"
                                  ]
                  },
                  {
                      "lineId":  "dlg-019",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "手，還是箱子？",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-017"
                                  ]
                  },
                  {
                      "lineId":  "dlg-020",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-zhou-ke",
                      "text":  "現在！",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-021"
                                  ]
                  },
                  {
                      "lineId":  "dlg-021",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "太快了。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-023"
                                  ]
                  },
                  {
                      "lineId":  "dlg-022",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-zhou-ke",
                      "text":  "潮表還沒到。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-023"
                                  ]
                  },
                  {
                      "lineId":  "dlg-023",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "是浪。下一波不知道什麼時候來。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-023"
                                  ]
                  },
                  {
                      "lineId":  "dlg-024",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "固定。抬高。布給我。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-024"
                                  ]
                  },
                  {
                      "lineId":  "dlg-025",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "裡面什麼？",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-024"
                                  ]
                  },
                  {
                      "lineId":  "dlg-026",
                      "sceneId":  "scene-03",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "好。先不問。",
                      "pressureLevel":  "HIGH",
                      "shotIds":  [
                                      "shot-024"
                                  ]
                  },
                  {
                      "lineId":  "dlg-027",
                      "sceneId":  "scene-04",
                      "speakerId":  "character-zhou-ke",
                      "text":  "回不去了。走上面。",
                      "shotIds":  [
                                      "shot-025"
                                  ]
                  },
                  {
                      "lineId":  "dlg-028",
                      "sceneId":  "scene-04",
                      "speakerId":  "character-zhou-ke",
                      "text":  "值守室能擋雨。我重撥一一九。",
                      "shotIds":  [
                                      "shot-025"
                                  ]
                  },
                  {
                      "lineId":  "dlg-029",
                      "sceneId":  "scene-04",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "走。",
                      "shotIds":  [
                                      "shot-026"
                                  ]
                  },
                  {
                      "lineId":  "dlg-030",
                      "sceneId":  "scene-04",
                      "speakerId":  "character-zhou-ke",
                      "text":  "大坪海岸，舊值守室。男性，左手重傷，人清醒，血止住了——",
                      "shotIds":  [
                                      "shot-028"
                                  ]
                  },
                  {
                      "lineId":  "dlg-031",
                      "sceneId":  "scene-04",
                      "speakerId":  "character-lu-chenxing",
                      "text":  "等雨小一點。",
                      "shotIds":  [
                                      "shot-031"
                                  ]
                  }
              ],
    "autoRevisionCount":  1,
    "sourceCommitSha":  "31f7072da143559c6a1280b3631ea2f70cad404d"
}
