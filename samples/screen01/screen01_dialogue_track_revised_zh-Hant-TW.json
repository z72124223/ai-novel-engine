  "lines": [
    {"dialogueId":"dlg-001","sceneId":"scene-01","speakerId":"character-lu-chenxing","text":"好。今天還有別的。","estimatedSeconds":1.8},
    {"dialogueId":"dlg-002","sceneId":"scene-01","speakerId":"character-lu-chenxing","text":"又不肯直接講。","estimatedSeconds":1.5},
    {"dialogueId":"dlg-003","sceneId":"scene-01","speakerId":"character-lu-chenxing","text":"有人搬過。還不只一趟。","estimatedSeconds":2.2},
    {"dialogueId":"dlg-004","sceneId":"scene-01","speakerId":"character-zhou-ke","text":"十分鐘！走人！","estimatedSeconds":1.4},
    {"dialogueId":"dlg-005","sceneId":"scene-01","speakerId":"character-lu-chenxing","text":"你上次的十分鐘，有含稅嗎？","estimatedSeconds":2.4},
    {"dialogueId":"dlg-006","sceneId":"scene-01","speakerId":"character-zhou-ke","text":"今天不要賭。","estimatedSeconds":1.5},
    {"dialogueId":"dlg-007","sceneId":"scene-02","speakerId":"character-zhou-ke","text":"照片呢？","estimatedSeconds":1.0},
    {"dialogueId":"dlg-008","sceneId":"scene-02","speakerId":"character-lu-chenxing","text":"卡住了。看它賞不賞臉。","estimatedSeconds":2.2},
    {"dialogueId":"dlg-009","sceneId":"scene-02","speakerId":"character-zhou-ke","text":"山坡在另一邊。","estimatedSeconds":1.5},
    {"dialogueId":"dlg-010","sceneId":"scene-02","speakerId":"character-lu-chenxing","text":"先看得到的。","estimatedSeconds":1.5},
    {"dialogueId":"dlg-011","sceneId":"scene-02","speakerId":"character-tide-picker","text":"別碰箱子。","estimatedSeconds":1.4},
    {"dialogueId":"dlg-012","sceneId":"scene-02","speakerId":"character-lu-chenxing","text":"好。先碰你。","estimatedSeconds":1.5},
    {"dialogueId":"dlg-013","sceneId":"scene-02","speakerId":"character-tide-picker","text":"那是我的。","estimatedSeconds":1.2},
    {"dialogueId":"dlg-014","sceneId":"scene-02","speakerId":"character-lu-chenxing","text":"先上去。箱子等等再說。","estimatedSeconds":2.2},
    {"dialogueId":"dlg-015","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"我抬石頭。你拉人。","estimatedSeconds":1.8},
    {"dialogueId":"dlg-016","sceneId":"scene-03","speakerId":"character-zhou-ke","text":"箱子？","estimatedSeconds":0.9},
    {"dialogueId":"dlg-017","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"不管。","estimatedSeconds":0.8},
    {"dialogueId":"dlg-018","sceneId":"scene-03","speakerId":"character-tide-picker","text":"不行！","estimatedSeconds":0.8},
    {"dialogueId":"dlg-019","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"手，還是箱子？","estimatedSeconds":1.5},
    {"dialogueId":"dlg-020","sceneId":"scene-03","speakerId":"character-zhou-ke","text":"現在！","estimatedSeconds":0.6},
    {"dialogueId":"dlg-021","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"太快了。","estimatedSeconds":1.0},
    {"dialogueId":"dlg-022","sceneId":"scene-03","speakerId":"character-zhou-ke","text":"潮表還早。","estimatedSeconds":1.3},
    {"dialogueId":"dlg-023","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"是浪。下一波不知道什麼時候來。","estimatedSeconds":2.7},
    {"dialogueId":"dlg-024","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"固定。抬高。布給我。","estimatedSeconds":1.9},
    {"dialogueId":"dlg-025","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"裡面什麼？","estimatedSeconds":1.1},
    {"dialogueId":"dlg-026","sceneId":"scene-03","speakerId":"character-lu-chenxing","text":"好。先不問。","estimatedSeconds":1.4},
    {"dialogueId":"dlg-027","sceneId":"scene-04","speakerId":"character-zhou-ke","text":"回不去了。走上面。","estimatedSeconds":1.6},
    {"dialogueId":"dlg-028","sceneId":"scene-04","speakerId":"character-zhou-ke","text":"值守室能擋雨。我重撥一一九。","estimatedSeconds":2.5},
    {"dialogueId":"dlg-029","sceneId":"scene-04","speakerId":"character-lu-chenxing","text":"走。","estimatedSeconds":0.6},
    {"dialogueId":"dlg-030","sceneId":"scene-04","speakerId":"character-zhou-ke","text":"大坪海岸，舊值守室。男性，左手重傷，人清醒，血止住了——","estimatedSeconds":4.0},
    {"dialogueId":"dlg-031","sceneId":"scene-04","speakerId":"character-lu-chenxing","text":"等雨小一點。","estimatedSeconds":1.5}
  ],
  "totalDialogueEstimatedSeconds": 49.0
}
