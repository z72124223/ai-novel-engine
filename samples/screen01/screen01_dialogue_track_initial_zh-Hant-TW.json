{
  "schemaVersion": "screen01-dialogue-track-v1",
  "productionId": "screen01-tideline-beyond",
  "version": "INITIAL",
  "language": "zh-Hant-TW",
  "sourceScreenplayPath": "samples/screen01/screen01_screenplay_initial_zh-Hant-TW.md",
  "sourceScreenplaySha256": "dd481504e7302afd371261bbfa91f8a5101d98c72c12fa3f901e138299fa4492",
  "dialogueBiblePath": "samples/screen01/screen01_dialogue_bible_zh-Hant-TW.json",
  "dialogueBibleSha256": "023d5a1361bf8bb22afc847e02bb07823f7a3c7e5bb89a4772b125d9514f3cd2",
  "lines": [
    {"dialogueId": "dlg-001", "sceneId": "scene-01", "speakerId": "character-lu-chenxing", "text": "好。今天多一項。", "intent": "承認異常但不驚動同伴", "subtext": "愛醬已先注意到非海象方向的問題", "estimatedSeconds": 1.6},
    {"dialogueId": "dlg-002", "sceneId": "scene-01", "speakerId": "character-lu-chenxing", "text": "一隻不肯報答案的狗。", "intent": "用乾式玩笑測試愛醬反應", "subtext": "他信任愛醬的判斷", "estimatedSeconds": 2.0},
    {"dialogueId": "dlg-003", "sceneId": "scene-01", "speakerId": "character-lu-chenxing", "text": "有人搬過。還不只一趟。", "intent": "記錄最低限度現場結論", "subtext": "人為行動已成立，來源仍未知", "estimatedSeconds": 2.2},
    {"dialogueId": "dlg-004", "sceneId": "scene-01", "speakerId": "character-zhou-ke", "text": "十分鐘！走人！", "intent": "設定撤退期限", "subtext": "海況比潮表危險", "estimatedSeconds": 1.4},
    {"dialogueId": "dlg-005", "sceneId": "scene-01", "speakerId": "character-lu-chenxing", "text": "你上次的十分鐘，有含稅嗎？", "intent": "以玩笑消化壓力", "subtext": "他仍在搶最後取證時間", "estimatedSeconds": 2.4},
    {"dialogueId": "dlg-006", "sceneId": "scene-01", "speakerId": "character-zhou-ke", "text": "今天不要賭。", "intent": "終止玩笑並要求撤退", "subtext": "周克真的害怕", "estimatedSeconds": 1.5},
    {"dialogueId": "dlg-007", "sceneId": "scene-02", "speakerId": "character-zhou-ke", "text": "照片呢？", "intent": "確認證據是否已離線備援", "subtext": "撤退前只問必要資訊", "estimatedSeconds": 1.0},
    {"dialogueId": "dlg-008", "sceneId": "scene-02", "speakerId": "character-lu-chenxing", "text": "卡著。現在靠祈禱。", "intent": "回報傳輸失敗", "subtext": "訊號不可靠但本機檔仍在", "estimatedSeconds": 2.0},
    {"dialogueId": "dlg-009", "sceneId": "scene-02", "speakerId": "character-zhou-ke", "text": "山坡在另一邊。", "intent": "指出行進方向矛盾", "subtext": "懷疑追錯線", "estimatedSeconds": 1.5},
    {"dialogueId": "dlg-010", "sceneId": "scene-02", "speakerId": "character-lu-chenxing", "text": "先看得到的。", "intent": "把可見受困者優先於推理", "subtext": "未知身分暫不下結論", "estimatedSeconds": 1.5},
    {"dialogueId": "dlg-011", "sceneId": "scene-02", "speakerId": "character-tide-picker", "text": "別碰箱子。", "intent": "保住物件控制權", "subtext": "箱子比求救更先出口", "estimatedSeconds": 1.4},
    {"dialogueId": "dlg-012", "sceneId": "scene-02", "speakerId": "character-lu-chenxing", "text": "好。先碰你。", "intent": "拒絕碰箱並開始救人", "subtext": "不與傷者爭論所有權", "estimatedSeconds": 1.5},
    {"dialogueId": "dlg-013", "sceneId": "scene-02", "speakerId": "character-tide-picker", "text": "那是我的。", "intent": "重申所有權", "subtext": "害怕失去箱子", "estimatedSeconds": 1.2},
    {"dialogueId": "dlg-014", "sceneId": "scene-02", "speakerId": "character-lu-chenxing", "text": "等你上去，再慢慢證明。", "intent": "把爭議延後", "subtext": "先確保傷者能活著離開", "estimatedSeconds": 2.1},
    {"dialogueId": "dlg-015", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "我抬石頭。你拉人。", "intent": "分配救援動作", "subtext": "不留討論空間", "estimatedSeconds": 1.8},
    {"dialogueId": "dlg-016", "sceneId": "scene-03", "speakerId": "character-zhou-ke", "text": "箱子？", "intent": "確認是否兼顧證物", "subtext": "需要明確優先順序", "estimatedSeconds": 0.9},
    {"dialogueId": "dlg-017", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "不管。", "intent": "排除箱子", "subtext": "救人是唯一任務", "estimatedSeconds": 0.8},
    {"dialogueId": "dlg-018", "sceneId": "scene-03", "speakerId": "character-tide-picker", "text": "不行！", "intent": "阻止放棄箱子", "subtext": "利益執念壓過疼痛", "estimatedSeconds": 0.8},
    {"dialogueId": "dlg-019", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "手，還是箱子？", "intent": "逼傷者面對不可兼得", "subtext": "時間不足以說服", "estimatedSeconds": 1.5},
    {"dialogueId": "dlg-020", "sceneId": "scene-03", "speakerId": "character-zhou-ke", "text": "現在！", "intent": "抓住救援窗口", "subtext": "落石尚未完全咬死", "estimatedSeconds": 0.6},
    {"dialogueId": "dlg-021", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "十八分鐘。", "intent": "校正現場經過時間", "subtext": "海況升高不是潮表跳時", "estimatedSeconds": 1.1},
    {"dialogueId": "dlg-022", "sceneId": "scene-03", "speakerId": "character-zhou-ke", "text": "潮表還早。", "intent": "指出數字與現場矛盾", "subtext": "撤退不能再看天文潮", "estimatedSeconds": 1.3},
    {"dialogueId": "dlg-023", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "是浪。下一批不知道什麼時候。", "intent": "界定真正風險", "subtext": "颱風長周期浪不可預測", "estimatedSeconds": 2.5},
    {"dialogueId": "dlg-024", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "固定。抬高。布給我。", "intent": "急救分工", "subtext": "進入處置模式", "estimatedSeconds": 1.9},
    {"dialogueId": "dlg-025", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "裡面什麼？", "intent": "在處置時測試傷者是否願意說", "subtext": "不強迫揭露", "estimatedSeconds": 1.1},
    {"dialogueId": "dlg-026", "sceneId": "scene-03", "speakerId": "character-lu-chenxing", "text": "行。先留著。", "intent": "接受沉默並停止逼問", "subtext": "救援不交換秘密", "estimatedSeconds": 1.5},
    {"dialogueId": "dlg-027", "sceneId": "scene-04", "speakerId": "character-zhou-ke", "text": "回不去了。走上面。", "intent": "切換撤退路線", "subtext": "潮間帶路線已封閉", "estimatedSeconds": 1.6},
    {"dialogueId": "dlg-028", "sceneId": "scene-04", "speakerId": "character-zhou-ke", "text": "值守室能擋雨。我重撥一一九。", "intent": "指定暫避點與救援聯繫", "subtext": "醫療閉合優先", "estimatedSeconds": 2.5},
    {"dialogueId": "dlg-029", "sceneId": "scene-04", "speakerId": "character-lu-chenxing", "text": "走。", "intent": "結束取證並撤離", "subtext": "接受暫時失去箱子控制權", "estimatedSeconds": 0.6},
    {"dialogueId": "dlg-030", "sceneId": "scene-04", "speakerId": "character-zhou-ke", "text": "大坪海岸，舊值守室。男性，手部重傷——", "intent": "向救護端回報位置與傷勢", "subtext": "電話終於接通", "estimatedSeconds": 3.2},
    {"dialogueId": "dlg-031", "sceneId": "scene-04", "speakerId": "character-lu-chenxing", "text": "等雨小一點。", "intent": "延後追查", "subtext": "他注意到窄徑，但先守住當下", "estimatedSeconds": 1.5}
  ],
  "totalDialogueEstimatedSeconds": 49.1
}
