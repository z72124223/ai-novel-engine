{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.invalid/schemas/npc_actor_human_blind_review_result_v1.schema.json",
  "title": "NPC Actor Human Blind Review Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packetId",
    "reviewStatus",
    "reviewedAt",
    "answerKeyDisclosedBeforeCompletion",
    "ratings",
    "summary",
    "decision",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packetId": { "type": "string", "minLength": 1 },
    "reviewStatus": { "const": "HUMAN_BLIND_REVIEW_COMPLETE" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewerRole": { "const": "PRODUCT_OWNER" },
    "answerKeyDisclosedBeforeCompletion": { "const": false },
    "ratings": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewId", "selectedOption", "actorOption", "outcome"],
        "properties": {
          "reviewId": { "type": "string", "pattern": "^review-npc-actor01-[0-9]{2}$" },
          "selectedOption": { "enum": ["A", "B", "TIE", "BOTH_FAIL"] },
          "actorOption": { "enum": ["A", "B"] },
          "outcome": { "enum": ["ACTOR_PREFERRED", "BASELINE_PREFERRED", "TIE", "BOTH_FAIL"] },
          "knowledgeLeakFlagged": { "type": "boolean" },
          "safetyRegressionFlagged": { "type": "boolean" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratingCount",
        "actorPreferredCount",
        "baselinePreferredCount",
        "tieCount",
        "bothFailCount",
        "knowledgeLeakFlagCount",
        "safetyRegressionFlagCount"
      ],
      "properties": {
        "ratingCount": { "const": 20 },
        "actorPreferredCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "baselinePreferredCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "tieCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "bothFailCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "knowledgeLeakFlagCount": { "type": "integer", "minimum": 0, "maximum": 20 },
        "safetyRegressionFlagCount": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "decision": {
      "const": "OFFLINE_FOUNDATION_ACCEPTED_WITH_EVALUATION_LIMITATION"
    },
    "reviewerValidityConcern": { "type": "string", "minLength": 1 },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "notSupported", "requiredNextEvidence"],
      "properties": {
        "supported": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notSupported": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requiredNextEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
