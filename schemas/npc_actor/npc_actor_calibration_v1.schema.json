{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.example/schemas/npc_actor/npc_actor_calibration_v1.schema.json",
  "title": "NPC Actor Adaptive Expression Calibration Artifacts V1",
  "oneOf": [
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/suite" },
    { "$ref": "#/$defs/reviewPacket" },
    { "$ref": "#/$defs/answerKey" },
    { "$ref": "#/$defs/technicalReport" },
    { "$ref": "#/$defs/humanReviewResult" }
  ],
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "policyId", "revisionNumber", "status", "decisionOrder", "rules", "claimBoundary"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "policyId": { "const": "npc-actor-adaptive-expression-v1" },
        "revisionNumber": { "const": 1 },
        "status": { "const": "EVALUATION_ONLY" },
        "decisionOrder": {
          "type": "array",
          "prefixItems": [
            { "const": "IMMEDIATE_NEED" },
            { "const": "KNOWLEDGE_AND_SAFETY_BOUNDARY" },
            { "const": "RELATIONSHIP_AND_AUDIENCE" },
            { "const": "PRIVATE_MOTIVE_EXPRESSION_CHANNEL" },
            { "const": "VOICE_INTENSITY" }
          ],
          "items": false
        },
        "rules": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ruleId", "instruction"],
            "properties": {
              "ruleId": { "type": "string", "minLength": 1 },
              "instruction": { "type": "string", "minLength": 1 }
            }
          }
        },
        "claimBoundary": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speakerId", "speakerLabel", "utterance", "nonverbal"],
      "properties": {
        "speakerId": { "type": "string", "minLength": 1 },
        "speakerLabel": { "type": "string", "minLength": 1 },
        "utterance": { "type": "string" },
        "nonverbal": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "summary", "visibility", "sourceSha256"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "visibility": { "enum": ["ACTOR_OWNED", "ACTOR_VISIBLE", "AUTHOR_ONLY"] },
        "sourceSha256": { "type": ["string", "null"] }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediateNeed", "relationshipDistance", "audiencePressure", "urgency", "expressionLevel"],
      "properties": {
        "immediateNeed": { "type": "string", "minLength": 1 },
        "relationshipDistance": { "enum": ["STRANGER", "CUSTOMER", "KNOWN_PROFESSIONAL", "WORKING_ALLY", "SUBORDINATE", "APPRENTICE", "LONG_TERM_PATIENT", "EMPLOYEE"] },
        "audiencePressure": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "urgency": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "expressionLevel": { "enum": ["MINIMAL", "LOW", "RESTRAINED", "MEDIUM"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "turns"],
      "properties": {
        "sourceType": { "enum": ["NATURAL_CONTROL_FIXTURE", "ADAPTIVE_ACTOR_FIXTURE"] },
        "turns": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/turn" } }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId", "title", "category", "boundary", "policyId", "actorId", "actorSpeakerId",
        "reviewerCharacterBrief", "sceneContext", "calibrationSignals", "actorOwnedEvidence",
        "forbiddenEvidence", "sharedOpeningTurns", "naturalControlCandidate", "adaptiveActorCandidate",
        "ratingDimensions", "lengthExceptionReason"
      ],
      "properties": {
        "scenarioId": { "type": "string", "pattern": "^npc-actor03-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "boundary": { "const": "NON_CANON_EVALUATION" },
        "policyId": { "const": "npc-actor-adaptive-expression-v1" },
        "actorId": { "type": "string", "minLength": 1 },
        "actorSpeakerId": { "type": "string", "minLength": 1 },
        "reviewerCharacterBrief": { "type": "string", "minLength": 1 },
        "sceneContext": { "type": "string", "minLength": 1 },
        "calibrationSignals": { "$ref": "#/$defs/signals" },
        "actorOwnedEvidence": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/evidence" } },
        "forbiddenEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "sharedOpeningTurns": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/turn" } },
        "naturalControlCandidate": { "$ref": "#/$defs/candidate" },
        "adaptiveActorCandidate": { "$ref": "#/$defs/candidate" },
        "ratingDimensions": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "lengthExceptionReason": { "type": ["string", "null"] }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "suiteId", "status", "fixtureOrigin", "policyId", "randomizationSeed", "scenarios"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "suiteId": { "const": "npc-actor03-adaptive-holdout-8-v1" },
        "status": { "const": "NON_CANON_HOLDOUT_READY" },
        "fixtureOrigin": { "const": "MANUALLY_AUTHORED_OFFLINE_HOLDOUT_FIXTURE" },
        "policyId": { "const": "npc-actor-adaptive-expression-v1" },
        "randomizationSeed": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/scenario" } }
      }
    },
    "reviewOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns"],
      "properties": { "turns": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/turn" } } }
    },
    "reviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "scenarioId", "title", "characterBrief", "sceneContext", "sharedOpeningTurns", "optionA", "optionB", "ratingDimensions", "ratingPrompt"],
      "properties": {
        "reviewId": { "type": "string", "pattern": "^review-npc-actor03-[0-9]{2}$" },
        "scenarioId": { "type": "string", "pattern": "^npc-actor03-[0-9]{2}$" },
        "title": { "type": "string", "minLength": 1 },
        "characterBrief": { "type": "string", "minLength": 1 },
        "sceneContext": { "type": "string", "minLength": 1 },
        "sharedOpeningTurns": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/turn" } },
        "optionA": { "$ref": "#/$defs/reviewOption" },
        "optionB": { "$ref": "#/$defs/reviewOption" },
        "ratingDimensions": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string" } },
        "ratingPrompt": { "type": "string", "minLength": 1 }
      }
    },
    "reviewPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "packetId", "status", "sourceDisclosure", "items"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "packetId": { "type": "string", "minLength": 1 },
        "status": { "const": "HUMAN_REVIEW_REQUIRED" },
        "sourceDisclosure": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/reviewItem" } }
      }
    },
    "answerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "packetId", "randomizationMethod", "randomizationSeed", "answers"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "packetId": { "type": "string", "minLength": 1 },
        "randomizationMethod": { "const": "SHA256_RANK_BALANCED" },
        "randomizationSeed": { "type": "string", "minLength": 1 },
        "answers": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewId", "adaptiveActorOption"],
            "properties": {
              "reviewId": { "type": "string", "pattern": "^review-npc-actor03-[0-9]{2}$" },
              "adaptiveActorOption": { "enum": ["A", "B"] }
            }
          }
        }
      }
    },
    "technicalReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "suiteId", "policyId", "scenarioCount", "profileCount", "adaptiveOptionACount",
        "adaptiveOptionBCount", "developmentScenarioIdOverlapCount", "developmentContentFingerprintOverlapCount",
        "turnStructureViolationCount", "strawmanPatternCount", "forbiddenInformationViolationCount",
        "lengthBalanceViolationCount", "maximumSpokenLengthRatio", "technicalDecision",
        "humanBlindReviewStatus", "claimBoundary"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "suiteId": { "type": "string", "minLength": 1 },
        "policyId": { "const": "npc-actor-adaptive-expression-v1" },
        "scenarioCount": { "const": 8 },
        "profileCount": { "const": 4 },
        "adaptiveOptionACount": { "const": 4 },
        "adaptiveOptionBCount": { "const": 4 },
        "developmentScenarioIdOverlapCount": { "const": 0 },
        "developmentContentFingerprintOverlapCount": { "const": 0 },
        "turnStructureViolationCount": { "const": 0 },
        "strawmanPatternCount": { "const": 0 },
        "forbiddenInformationViolationCount": { "const": 0 },
        "lengthBalanceViolationCount": { "const": 0 },
        "maximumSpokenLengthRatio": { "type": "number", "maximum": 1.25 },
        "technicalDecision": { "const": "TECHNICAL_PASS_HUMAN_REVIEW_PENDING" },
        "humanBlindReviewStatus": { "const": "HUMAN_BLIND_REVIEW_PENDING" },
        "claimBoundary": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "humanReviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "packetId", "status", "reviewerRole", "answerKeyOpenedBeforeCompletion", "ratings"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "packetId": { "type": "string", "minLength": 1 },
        "status": { "const": "COMPLETE_BEFORE_ANSWER_KEY_DISCLOSURE" },
        "reviewerRole": { "const": "PRODUCT_OWNER" },
        "answerKeyOpenedBeforeCompletion": { "const": false },
        "ratings": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewId", "selection", "flaggedDimensions", "knowledgeBoundaryConcern", "safetyBoundaryConcern", "notes"],
            "properties": {
              "reviewId": { "type": "string", "pattern": "^review-npc-actor03-[0-9]{2}$" },
              "selection": { "enum": ["A", "B", "TIE", "BOTH_FAIL"] },
              "flaggedDimensions": { "type": "array", "uniqueItems": true, "items": { "enum": ["NATURALNESS", "VOICE_CONSISTENCY", "MOTIVE_COHERENCE", "KNOWLEDGE_BOUNDARY", "CONTINUITY", "MULTI_TURN_REPAIR"] } },
              "knowledgeBoundaryConcern": { "type": "boolean" },
              "safetyBoundaryConcern": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
