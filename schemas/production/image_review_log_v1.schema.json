{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.example/schemas/production/image_review_log_v1.schema.json",
  "title": "Image Review Log V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffId",
    "logStatus",
    "candidateReviews",
    "approvalBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "image-review-log-v1"
    },
    "handoffId": {
      "$ref": "#/$defs/nonBlank"
    },
    "logStatus": {
      "enum": [
        "DRAFT",
        "PENDING_USER_REVIEW",
        "USER_DECISION_RECORDED",
        "READY_FOR_CODEX_INTAKE"
      ]
    },
    "candidateReviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewId",
          "shotId",
          "candidateId",
          "candidateFilePath",
          "sourceFileSha256",
          "reviewState",
          "reviewedBy",
          "reviewedAt",
          "driftFindings",
          "decisionReason",
          "exactCandidateIdentity"
        ],
        "properties": {
          "reviewId": {
            "$ref": "#/$defs/nonBlank"
          },
          "shotId": {
            "$ref": "#/$defs/nonBlank"
          },
          "candidateId": {
            "$ref": "#/$defs/nonBlank"
          },
          "candidateFilePath": {
            "oneOf": [
              {
                "$ref": "#/$defs/repositoryPath"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceFileSha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewState": {
            "enum": [
              "PENDING_USER_REVIEW",
              "APPROVE_CANDIDATE",
              "REJECT_DRIFT",
              "REQUEST_VARIATION",
              "CHANGE_VISUAL_DIRECTION"
            ]
          },
          "reviewedBy": {
            "oneOf": [
              {
                "$ref": "#/$defs/nonBlank"
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewedAt": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "driftFindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "severity",
                "note"
              ],
              "properties": {
                "code": {
                  "enum": [
                    "FACE_DRIFT",
                    "BODY_DRIFT",
                    "AGE_DRIFT",
                    "HAIR_OR_GLASSES_DRIFT",
                    "COSTUME_DRIFT",
                    "AIJIANG_MARKING_DRIFT",
                    "SCALE_DRIFT",
                    "SCENE_GEOMETRY_DRIFT",
                    "PROP_DRIFT",
                    "WEATHER_OR_TIME_DRIFT",
                    "STYLE_DRIFT",
                    "SHOT_CONTINUITY_DRIFT",
                    "EXTRA_CHARACTER_OR_OBJECT",
                    "OTHER"
                  ]
                },
                "severity": {
                  "enum": [
                    "INFO",
                    "MINOR",
                    "MAJOR",
                    "CRITICAL"
                  ]
                },
                "note": {
                  "$ref": "#/$defs/nonBlank"
                }
              }
            }
          },
          "decisionReason": {
            "type": "string"
          },
          "exactCandidateIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expectedFileName",
              "hashStatus"
            ],
            "properties": {
              "expectedFileName": {
                "type": "string",
                "pattern": "^[^\\\\/:*?\"<>|]+\\.(png|jpg|jpeg|webp)$"
              },
              "hashStatus": {
                "enum": [
                  "PENDING_CODEX_INTAKE",
                  "VERIFIED"
                ]
              }
            }
          }
        }
      }
    },
    "approvalBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalAppliesToCandidateOnly",
        "candidateReferenceAcceptanceStillRequired",
        "technicalPassIsNotApproval"
      ],
      "properties": {
        "approvalAppliesToCandidateOnly": {
          "const": true
        },
        "candidateReferenceAcceptanceStillRequired": {
          "const": true
        },
        "technicalPassIsNotApproval": {
          "const": true
        }
      }
    },
    "exampleOnly": {
      "type": "boolean"
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*://).+"
    }
  }
}
