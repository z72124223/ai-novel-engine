{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.example/schemas/production/location_bible_return_to_codex_v1.schema.json",
  "title": "Location Bible Return To Codex V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "handoffId", "returnStatus", "locationId", "candidates", "intakeBoundary"],
  "properties": {
    "schemaVersion": { "const": "location-bible-return-to-codex-v1" },
    "handoffId": { "$ref": "#/$defs/nonBlank" },
    "returnStatus": { "enum": ["DRAFT", "CODEX_INTAKE_READY", "INTAKE_VALIDATED", "INTAKE_REJECTED"] },
    "locationId": { "$ref": "#/$defs/nonBlank" },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "taskId", "componentType", "candidateId", "expectedFileName", "localFilePath",
          "userDecision", "userDecisionReason", "driftFindings", "sourceConversationNote",
          "sourceFileSha256", "intakeStatus", "nextRequiredCliStages"
        ],
        "properties": {
          "taskId": { "$ref": "#/$defs/nonBlank" },
          "componentType": { "$ref": "#/$defs/componentType" },
          "candidateId": { "$ref": "#/$defs/nonBlank" },
          "expectedFileName": { "type": "string", "pattern": "^[^\\\\/:*?\"<>|]+\\.(png|jpg|jpeg|webp)$" },
          "localFilePath": { "oneOf": [{ "$ref": "#/$defs/repositoryPath" }, { "type": "null" }] },
          "userDecision": { "enum": ["PENDING_USER_REVIEW", "APPROVE_CANDIDATE", "REJECT_DRIFT", "REQUEST_VARIATION", "CHANGE_VISUAL_DIRECTION"] },
          "userDecisionReason": { "type": "string" },
          "driftFindings": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["code", "severity", "note"],
              "properties": {
                "code": { "enum": ["SCENE_GEOMETRY_DRIFT", "SCALE_DRIFT", "PROP_DRIFT", "WEATHER_OR_TIME_DRIFT", "STYLE_DRIFT", "SHOT_CONTINUITY_DRIFT", "EXTRA_CHARACTER_OR_OBJECT", "OTHER"] },
                "severity": { "enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"] },
                "note": { "$ref": "#/$defs/nonBlank" }
              }
            }
          },
          "sourceConversationNote": { "type": "string" },
          "sourceFileSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "intakeStatus": { "enum": ["PENDING_FILE_TRANSFER", "HASH_REQUIRED", "READY_FOR_EXTERNAL_RESULT_INTAKE", "VALIDATED", "REJECTED"] },
          "nextRequiredCliStages": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "enum": [
                "validate-image-candidate-external-result-intake",
                "validate-image-candidate-result-review-preflight",
                "validate-image-candidate-result-human-review-decision",
                "create-image-candidate-reference-packet",
                "validate-image-candidate-reference-packet",
                "validate-candidate-reference-human-acceptance-decision",
                "validate-candidate-reference-registry-preflight",
                "create-candidate-reference-registry-packet",
                "validate-candidate-reference-registry-packet",
                "validate-candidate-reference-registry-human-acceptance-decision",
                "create-candidate-reference-acceptance-packet",
                "validate-candidate-reference-acceptance-packet"
              ]
            }
          }
        }
      }
    },
    "intakeBoundary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "approvalAppliesToExactCandidateOnly", "sourceFileSha256RequiredAfterCodexReceivesFile",
        "existingExternalResultHumanReviewAndCandidateReferenceStagesRequired",
        "approvalDoesNotWriteCanonOrSqlite", "locationReferenceAcceptanceDoesNotApproveStoryShotsOrFinalMedia"
      ],
      "properties": {
        "approvalAppliesToExactCandidateOnly": { "const": true },
        "sourceFileSha256RequiredAfterCodexReceivesFile": { "const": true },
        "existingExternalResultHumanReviewAndCandidateReferenceStagesRequired": { "const": true },
        "approvalDoesNotWriteCanonOrSqlite": { "const": true },
        "locationReferenceAcceptanceDoesNotApproveStoryShotsOrFinalMedia": { "const": true }
      }
    },
    "exampleOnly": { "type": "boolean" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryPath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*://).+" },
    "componentType": { "enum": ["MASTER_PANORAMA", "TOP_DOWN_ZONE_PLAN", "DIRECTIONAL_VIEW", "ANCHOR_DETAIL", "SCALE_REFERENCE", "WEATHER_LIGHTING_REFERENCE", "OPTIONAL_360_PANORAMA"] }
  }
}
