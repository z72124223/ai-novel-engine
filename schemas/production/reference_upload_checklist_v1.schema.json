{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.example/schemas/production/reference_upload_checklist_v1.schema.json",
  "title": "Reference Upload Checklist V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "handoffId",
    "status",
    "items",
    "formalGenerationRule"
  ],
  "properties": {
    "schemaVersion": {
      "const": "reference-upload-checklist-v1"
    },
    "handoffId": {
      "$ref": "#/$defs/nonBlank"
    },
    "status": {
      "enum": [
        "DRAFT",
        "REFERENCE_UPLOAD_REQUIRED",
        "UPLOAD_COMPLETE",
        "READY_FOR_GENERATION"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceId",
          "repositoryPath",
          "assetRole",
          "entityId",
          "version",
          "required",
          "requirementCategory",
          "expectedSha256",
          "whyNeeded",
          "canProceedWithoutIt",
          "degradedMode",
          "uploadStatus"
        ],
        "properties": {
          "referenceId": {
            "$ref": "#/$defs/nonBlank"
          },
          "repositoryPath": {
            "$ref": "#/$defs/repositoryPath"
          },
          "assetRole": {
            "$ref": "#/$defs/nonBlank"
          },
          "entityId": {
            "$ref": "#/$defs/nonBlank"
          },
          "version": {
            "$ref": "#/$defs/nonBlank"
          },
          "required": {
            "type": "boolean"
          },
          "requirementCategory": {
            "enum": [
              "LIKENESS",
              "BODY",
              "COSTUME",
              "ANIMAL_APPEARANCE",
              "LOCATION_GEOMETRY",
              "PROP_GEOMETRY",
              "STYLE_ONLY",
              "CONTINUITY_FRAME",
              "OPTIONAL_CONTEXT"
            ]
          },
          "expectedSha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "whyNeeded": {
            "$ref": "#/$defs/nonBlank"
          },
          "canProceedWithoutIt": {
            "type": "boolean"
          },
          "degradedMode": {
            "enum": [
              "NONE",
              "ROUGH_CONCEPT_ONLY",
              "STYLE_EXPLORATION_ONLY",
              "BLOCK_FORMAL_GENERATION"
            ]
          },
          "uploadStatus": {
            "enum": [
              "NOT_AVAILABLE_IN_CONVERSATION",
              "UPLOAD_REQUIRED",
              "UPLOADED_UNVERIFIED",
              "UPLOADED_VERIFIED",
              "NOT_REQUIRED",
              "WAIVED_DEGRADED_MODE"
            ]
          },
          "placeholder": {
            "type": "boolean"
          },
          "placeholderReason": {
            "type": "string"
          }
        }
      }
    },
    "formalGenerationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingRequiredVisualReferenceStatus",
        "textOnlyFormalGenerationAllowed",
        "humanUploadConfirmationRequired"
      ],
      "properties": {
        "missingRequiredVisualReferenceStatus": {
          "const": "REFERENCE_UPLOAD_REQUIRED"
        },
        "textOnlyFormalGenerationAllowed": {
          "const": false
        },
        "humanUploadConfirmationRequired": {
          "const": true
        }
      }
    },
    "exampleOnly": {
      "type": "boolean"
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*://).+"
    }
  }
}
