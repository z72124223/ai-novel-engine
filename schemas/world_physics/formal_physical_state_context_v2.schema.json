{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.example/schemas/world_physics/formal_physical_state_context_v2.schema.json",
  "title": "WORLD-PHYSICS-04 Formal Physical State Context V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "boundary",
    "projectId",
    "sessionId",
    "turnId",
    "contextId",
    "contextHash",
    "turnNumber",
    "baseStateVersion",
    "resultId",
    "resultCanonicalSha256",
    "physicalStateVersion",
    "physicalSnapshotCanonicalSha256",
    "physicalArchetypeRegistryCanonicalSha256",
    "physicalArchetypes",
    "physicalSnapshot",
    "allowedPhysicalActionTypes",
    "allowedPhysicalActorIds",
    "allowedPhysicalTargetIds"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "boundary": { "const": "FORMAL_TURN_VALIDATION_INPUT" },
    "projectId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "minLength": 1 },
    "contextId": { "type": "string", "minLength": 1 },
    "contextHash": { "type": "string", "minLength": 1 },
    "turnNumber": { "type": "integer", "minimum": 1 },
    "baseStateVersion": { "type": "integer", "minimum": 0 },
    "resultId": { "type": "string", "minLength": 1 },
    "resultCanonicalSha256": { "$ref": "#/$defs/sha256" },
    "physicalStateVersion": { "type": "integer", "minimum": 0 },
    "physicalSnapshotCanonicalSha256": { "$ref": "#/$defs/sha256" },
    "physicalArchetypeRegistryCanonicalSha256": { "$ref": "#/$defs/sha256" },
    "physicalArchetypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "physical_affordance_v1.schema.json#/$defs/archetype" }
    },
    "physicalSnapshot": { "$ref": "#/$defs/snapshotV2" },
    "allowedPhysicalActionTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "physical_affordance_v1.schema.json#/$defs/actionType" }
    },
    "allowedPhysicalActorIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedPhysicalTargetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entityV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "label",
        "archetypeId",
        "centerCm",
        "heldByEntityId",
        "supportedByEntityId",
        "containedByEntityId",
        "supportLoadKgBySurface"
      ],
      "properties": {
        "entityId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "archetypeId": { "type": "string", "minLength": 1 },
        "centerCm": { "$ref": "physical_affordance_v1.schema.json#/$defs/vector" },
        "heldByEntityId": { "type": ["string", "null"] },
        "supportedByEntityId": { "type": ["string", "null"] },
        "supportedBySurfaceId": { "type": ["string", "null"] },
        "containedByEntityId": { "type": ["string", "null"] },
        "supportLoadKgBySurface": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "supportedByEntityId": { "type": "string" } },
            "required": ["supportedByEntityId"]
          },
          "then": {
            "required": ["supportedBySurfaceId"],
            "properties": { "supportedBySurfaceId": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "snapshotV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "boundary", "gravityMps2", "entities", "barriers"],
      "properties": {
        "snapshotId": { "type": "string", "minLength": 1 },
        "boundary": { "const": "FORMAL_TURN_VALIDATION_INPUT" },
        "gravityMps2": { "type": "number", "exclusiveMinimum": 0 },
        "entities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/entityV2" }
        },
        "barriers": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "physical_affordance_v1.schema.json#/$defs/barrier" }
        }
      }
    }
  }
}
