{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.invalid/schemas/world_physics/embodied_scene_physical_pilot_v1.schema.json",
  "title": "WORLD-PHYSICS-05 Embodied Scene Physical Pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pilotId",
    "boundary",
    "storyBoundary",
    "storyTitle",
    "sceneId",
    "locationId",
    "sourceFiles",
    "resolvedTurnCount",
    "rejectedAttemptCount",
    "physicalTransitionCount",
    "turns",
    "checks",
    "technicalDecision",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pilotId": { "const": "world-physics05-screen01-scene03-five-turn-v1" },
    "boundary": { "const": "NON_CANON_EVALUATION" },
    "storyBoundary": { "const": "NON_CANON_PILOT" },
    "storyTitle": { "const": "潮線之外" },
    "sceneId": { "const": "scene-03" },
    "locationId": { "const": "loc-daping-coast-recess" },
    "sourceFiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceEvidence" }
    },
    "resolvedTurnCount": { "const": 5 },
    "rejectedAttemptCount": { "const": 1 },
    "physicalTransitionCount": { "const": 5 },
    "turns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/turnEvidence" }
    },
    "checks": { "$ref": "#/$defs/checks" },
    "technicalDecision": { "const": "WORLD_PHYSICS05_EMBODIED_SCENE_PILOT_PASS" },
    "claimBoundary": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableId": { "type": ["string", "null"] },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^samples/screen01/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "entityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "centerCm",
        "heldByEntityId",
        "supportedByEntityId",
        "supportedBySurfaceId",
        "containedByEntityId"
      ],
      "properties": {
        "entityId": { "type": "string", "minLength": 1 },
        "centerCm": { "$ref": "#/$defs/vector" },
        "heldByEntityId": { "$ref": "#/$defs/nullableId" },
        "supportedByEntityId": { "$ref": "#/$defs/nullableId" },
        "supportedBySurfaceId": { "$ref": "#/$defs/nullableId" },
        "containedByEntityId": { "$ref": "#/$defs/nullableId" }
      }
    },
    "turnEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turnNumber",
        "playerInput",
        "rejectedActionId",
        "rejectionCodes",
        "resolvedActionIds",
        "resolvedActionTypes",
        "storyStateVersionBefore",
        "storyStateVersionAfter",
        "physicalStateVersionBefore",
        "physicalStateVersionAfter",
        "transitionCountBefore",
        "transitionCountAfter",
        "actorAfter",
        "toolAfter"
      ],
      "properties": {
        "turnNumber": { "type": "integer", "minimum": 1, "maximum": 5 },
        "playerInput": { "type": "string", "minLength": 1 },
        "rejectedActionId": { "$ref": "#/$defs/nullableId" },
        "rejectionCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "resolvedActionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "resolvedActionTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["USE_AS_SUPPORT", "LIFT", "PUSH", "REACH", "PLACE_ON", "DROP", "ENTER_CONTAINER", "PASS_THROUGH"]
          }
        },
        "storyStateVersionBefore": { "type": "integer", "minimum": 0 },
        "storyStateVersionAfter": { "type": "integer", "minimum": 1 },
        "physicalStateVersionBefore": { "type": "integer", "minimum": 0 },
        "physicalStateVersionAfter": { "type": "integer", "minimum": 0 },
        "transitionCountBefore": { "type": "integer", "minimum": 0 },
        "transitionCountAfter": { "type": "integer", "minimum": 0 },
        "actorAfter": { "$ref": "#/$defs/entityEvidence" },
        "toolAfter": { "$ref": "#/$defs/entityEvidence" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceHashesVerified",
        "dogSupportRejected",
        "rejectedAttemptStateUnchanged",
        "samePendingTurnRepairApplied",
        "heldToolFollowedHolder",
        "placedToolRelationPersisted",
        "droppedToolRelationsCleared",
        "formalRuntimeTurnCountVerified"
      ],
      "properties": {
        "sourceHashesVerified": { "const": true },
        "dogSupportRejected": { "const": true },
        "rejectedAttemptStateUnchanged": { "const": true },
        "samePendingTurnRepairApplied": { "const": true },
        "heldToolFollowedHolder": { "const": true },
        "placedToolRelationPersisted": { "const": true },
        "droppedToolRelationsCleared": { "const": true },
        "formalRuntimeTurnCountVerified": { "const": true }
      }
    }
  }
}
