{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.example/schemas/world_physics/formal_turn_physical_context_v1.schema.json",
  "title": "WORLD-PHYSICS-03 Formal Turn Physical Validation Context V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "boundary",
    "projectId",
    "sessionId",
    "turnId",
    "contextId",
    "contextHash",
    "turnNumber",
    "baseStateVersion",
    "resultId",
    "resultCanonicalSha256",
    "physicalArchetypes",
    "physicalSnapshot",
    "allowedPhysicalActionTypes",
    "allowedPhysicalActorIds",
    "allowedPhysicalTargetIds"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "boundary": { "const": "FORMAL_TURN_VALIDATION_INPUT" },
    "projectId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "minLength": 1 },
    "contextId": { "type": "string", "minLength": 1 },
    "contextHash": { "type": "string", "minLength": 1 },
    "turnNumber": { "type": "integer", "minimum": 1 },
    "baseStateVersion": { "type": "integer", "minimum": 0 },
    "resultId": { "type": "string", "minLength": 1 },
    "resultCanonicalSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "physicalArchetypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "physical_affordance_v1.schema.json#/$defs/archetype" }
    },
    "physicalSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "boundary", "gravityMps2", "entities", "barriers"],
      "properties": {
        "snapshotId": { "type": "string", "minLength": 1 },
        "boundary": { "const": "FORMAL_TURN_VALIDATION_INPUT" },
        "gravityMps2": { "type": "number", "minimum": 0 },
        "entities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": { "$ref": "physical_affordance_v1.schema.json#/$defs/entity" }
        },
        "barriers": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "physical_affordance_v1.schema.json#/$defs/barrier" }
        }
      }
    },
    "allowedPhysicalActionTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "physical_affordance_v1.schema.json#/$defs/actionType" }
    },
    "allowedPhysicalActorIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedPhysicalTargetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
