{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localnovel.example/schemas/world_physics/physical_affordance_v1.schema.json",
  "title": "WORLD-PHYSICS-01 Physical Affordance Evidence V1",
  "oneOf": [
    { "$ref": "#/$defs/suite" },
    { "$ref": "#/$defs/report" },
    { "$ref": "#/$defs/manifest" }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "actionType": {
      "enum": ["USE_AS_SUPPORT", "LIFT", "PUSH", "REACH", "PLACE_ON", "DROP", "ENTER_CONTAINER", "PASS_THROUGH"]
    },
    "supportUse": {
      "enum": ["LIGHT_CONTACT", "STAND_UP_ASSIST", "FULL_BODY_SUPPORT", "OBJECT_PLACEMENT"]
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "dimensions"],
      "properties": {
        "center": { "$ref": "#/$defs/vector" },
        "dimensions": { "$ref": "#/$defs/dimensions" }
      }
    },
    "supportSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "stable", "maxLoadKg", "widthCm", "depthCm", "allowedUses", "allowedBodyPlans"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/nonEmpty" },
        "stable": { "type": "boolean" },
        "maxLoadKg": { "type": "number", "minimum": 0 },
        "widthCm": { "type": "number", "exclusiveMinimum": 0 },
        "depthCm": { "type": "number", "exclusiveMinimum": 0 },
        "allowedUses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/supportUse" } },
        "allowedBodyPlans": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "archetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archetypeId", "entityKind", "bodyPlan", "massKg", "dimensionsCm", "movable", "canGrasp", "maxReachCm", "maxLiftKg", "maxPushKg", "supportSurfaces", "containerInteriorCm", "openingCm", "maxContainedLoadKg"],
      "properties": {
        "archetypeId": { "$ref": "#/$defs/nonEmpty" },
        "entityKind": { "$ref": "#/$defs/nonEmpty" },
        "bodyPlan": { "$ref": "#/$defs/nonEmpty" },
        "massKg": { "type": "number", "exclusiveMinimum": 0 },
        "dimensionsCm": { "$ref": "#/$defs/dimensions" },
        "movable": { "type": "boolean" },
        "canGrasp": { "type": "boolean" },
        "maxReachCm": { "type": "number", "minimum": 0 },
        "maxLiftKg": { "type": "number", "minimum": 0 },
        "maxPushKg": { "type": "number", "minimum": 0 },
        "supportSurfaces": { "type": "array", "items": { "$ref": "#/$defs/supportSurface" } },
        "containerInteriorCm": { "oneOf": [{ "$ref": "#/$defs/dimensions" }, { "type": "null" }] },
        "openingCm": { "oneOf": [{ "$ref": "#/$defs/dimensions" }, { "type": "null" }] },
        "maxContainedLoadKg": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "label", "archetypeId", "centerCm", "heldByEntityId", "supportedByEntityId", "containedByEntityId", "supportLoadKgBySurface"],
      "properties": {
        "entityId": { "$ref": "#/$defs/nonEmpty" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "archetypeId": { "$ref": "#/$defs/nonEmpty" },
        "centerCm": { "$ref": "#/$defs/vector" },
        "heldByEntityId": { "type": ["string", "null"] },
        "supportedByEntityId": { "type": ["string", "null"] },
        "containedByEntityId": { "type": ["string", "null"] },
        "supportLoadKgBySurface": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        }
      }
    },
    "barrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["barrierId", "boundsCm", "blocksReach", "blocksMovement"],
      "properties": {
        "barrierId": { "$ref": "#/$defs/nonEmpty" },
        "boundsCm": { "$ref": "#/$defs/bounds" },
        "blocksReach": { "type": "boolean" },
        "blocksMovement": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "boundary", "gravityMps2", "entities", "barriers"],
      "properties": {
        "snapshotId": { "type": "string", "pattern": "^snapshot-" },
        "boundary": { "const": "NON_CANON_EVALUATION" },
        "gravityMps2": { "type": "number", "minimum": 0 },
        "entities": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/entity" } },
        "barriers": { "type": "array", "items": { "$ref": "#/$defs/barrier" } }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "actionType", "actorId", "targetId", "secondaryTargetId", "supportSurfaceId", "supportUse", "destinationCenterCm"],
      "properties": {
        "actionId": { "$ref": "#/$defs/nonEmpty" },
        "actionType": { "$ref": "#/$defs/actionType" },
        "actorId": { "$ref": "#/$defs/nonEmpty" },
        "targetId": { "$ref": "#/$defs/nonEmpty" },
        "secondaryTargetId": { "type": ["string", "null"] },
        "supportSurfaceId": { "type": ["string", "null"] },
        "supportUse": { "oneOf": [{ "$ref": "#/$defs/supportUse" }, { "type": "null" }] },
        "destinationCenterCm": { "oneOf": [{ "$ref": "#/$defs/vector" }, { "type": "null" }] }
      }
    },
    "evaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "snapshotId", "proposal", "expectedAccepted", "expectedRejectionCodes", "expectedRequiredEffects"],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmpty" },
        "snapshotId": { "type": "string", "pattern": "^snapshot-" },
        "proposal": { "$ref": "#/$defs/proposal" },
        "expectedAccepted": { "type": "boolean" },
        "expectedRejectionCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "expectedRequiredEffects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "suiteId", "boundary", "archetypes", "snapshots", "cases"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "suiteId": { "const": "world-physics01-affordance-64-v1" },
        "boundary": { "const": "NON_CANON_EVALUATION" },
        "archetypes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/archetype" } },
        "snapshots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/snapshot" } },
        "cases": { "type": "array", "minItems": 64, "maxItems": 64, "items": { "$ref": "#/$defs/evaluationCase" } }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "matchedExpectation", "actualAccepted", "actualRejectionCodes", "actualRequiredEffects"],
      "properties": {
        "caseId": { "$ref": "#/$defs/nonEmpty" },
        "matchedExpectation": { "type": "boolean" },
        "actualAccepted": { "type": "boolean" },
        "actualRejectionCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "actualRequiredEffects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionType", "caseCount", "acceptedCaseCount", "rejectedCaseCount"],
      "properties": {
        "actionType": { "$ref": "#/$defs/actionType" },
        "caseCount": { "type": "integer", "minimum": 1 },
        "acceptedCaseCount": { "type": "integer", "minimum": 0 },
        "rejectedCaseCount": { "type": "integer", "minimum": 0 }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "suiteId", "caseCount", "expectationMatchCount", "expectationMismatchCount", "actionCoverage", "rejectionCodeCounts", "outcomes", "technicalDecision", "runtimeIntegrationStatus", "claimBoundary"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "suiteId": { "const": "world-physics01-affordance-64-v1" },
        "caseCount": { "const": 64 },
        "expectationMatchCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "expectationMismatchCount": { "type": "integer", "minimum": 0, "maximum": 64 },
        "actionCoverage": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/coverage" } },
        "rejectionCodeCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
        "outcomes": { "type": "array", "minItems": 64, "maxItems": 64, "items": { "$ref": "#/$defs/outcome" } },
        "technicalDecision": { "enum": ["FOUNDATION_TECHNICAL_PASS_RUNTIME_NOT_CONNECTED", "FOUNDATION_EXPECTATION_MISMATCH"] },
        "runtimeIntegrationStatus": { "const": "NOT_CONNECTED" },
        "claimBoundary": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "pattern": "^(samples/world_physics01|schemas/world_physics)/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "hashAlgorithm", "scope", "selfHashExcluded", "files"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "hashAlgorithm": { "const": "SHA-256" },
        "scope": { "const": "WORLD-PHYSICS-01 PHYSICAL AFFORDANCE FOUNDATION" },
        "selfHashExcluded": { "const": true },
        "files": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/evidenceFile" } }
      }
    }
  }
}
